# Copy to .env if you like, or export these in your shell. No secrets are stored here.
# Required: folder for your data. Must NOT be under ~/Documents, ~/Desktop or iCloud.
BUDGET_DATA_DIR=/Users/you/BudgetTrackerData
# Optional: port (host is always 127.0.0.1)
BUDGET_PORT=5055
# Optional: how many pre-import backups to keep in BUDGET_DATA_DIR/backups (default 20)
BUDGET_BACKUP_KEEP=20
